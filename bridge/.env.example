# Copy to .env in this folder (never commit .env).
# Get a free API key at https://physiology.presagetech.com/auth/login
PRESAGE_API_KEY=
PRESAGE_BRIDGE_PORT=8787
# wss:// listener (self-signed cert, auto-generated) for when the game page
# itself is https:// (e.g. deployed on Render) -- plain ws:// is blocked as
# mixed content from an https page in every browser, even to localhost.
PRESAGE_BRIDGE_WSS_PORT=8790
